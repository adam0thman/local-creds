{
  "manifest_version": 3,
  "name": "creds",
  "version": "0.4.0",
  "description": "Fill or copy a password from your local encrypted creds index for the site you are on.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "creds"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Look up credentials for this site"
    }
  }
}
